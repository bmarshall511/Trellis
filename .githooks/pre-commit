#!/usr/bin/env bash
# Trellis pre-commit. Fast checks only — anything slow belongs in pre-push.
#
# Deliberately dependency-free: this must work on a freshly downloaded repo, before any package
# manager has been chosen or anything installed.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0
failed=0

# A credential committed once lives in history and in every clone. This is the only cheap moment.
if [ -x .claude/scripts/scan-secrets.py ]; then
  .claude/scripts/scan-secrets.py --staged || failed=1
fi

# A malformed trellis.json breaks every gate silently, since everything reads it.
if [ -f trellis.json ] && [ -x .claude/scripts/validate-config.py ]; then
  .claude/scripts/validate-config.py >/dev/null || {
    echo "trellis.json is invalid. Run .claude/scripts/validate-config.py" >&2
    failed=1
  }
fi

# Cross-references inside Trellis itself. Sub-second, and catches the class of breakage that is
# otherwise invisible — a command loading a skill that was renamed.
if [ -x .claude/scripts/check-integrity.py ] && [ -d .claude/skills ]; then
  .claude/scripts/check-integrity.py >/dev/null || {
    echo "Trellis integrity check failed. Run .claude/scripts/check-integrity.py" >&2
    failed=1
  }
fi

# The map is derived from the tracked file set, so it goes stale whenever a file is added or removed.
# Failing here just makes every such commit a three-step dance, so regenerate and stage it instead --
# it is a generated file, and there is nothing for a human to decide.
if [ -x .claude/scripts/build-map.py ] && [ -d docs/map ]; then
  if ! .claude/scripts/build-map.py --check >/dev/null 2>&1; then
    .claude/scripts/build-map.py >/dev/null && git add docs/map/OVERVIEW.md \
      && echo "map: regenerated and staged"
  fi
fi

# Specs claiming to be implementable must pass the readiness checklist. This is the mechanism behind
# "never assumes" -- prose in a skill is not a control.
if [ -x .claude/scripts/spec-lint.py ] && [ -d docs/specs ]; then
  .claude/scripts/spec-lint.py --ready-only >/dev/null || {
    echo "A spec claiming ready/done fails the readiness checklist." >&2
    echo "  Run: .claude/scripts/spec-lint.py --ready-only" >&2
    failed=1
  }
fi

# A spec marked done whose criteria have no tests is the worst kind of wrong: nobody looks again.
if [ -x .claude/scripts/spec-coverage.py ] && [ -d docs/specs ]; then
  .claude/scripts/spec-coverage.py >/dev/null 2>&1 || {
    echo "A spec marked done or verifying has uncovered acceptance criteria." >&2
    echo "  Run: .claude/scripts/spec-coverage.py" >&2
    failed=1
  }
fi

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "Commit blocked. Fix the above, or --no-verify if you are certain and can say why." >&2
  exit 1
fi
