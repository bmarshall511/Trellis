# Generated by Trellis, not by people. Merging them by hand is never right — the correct result is
# derived from the merged tree, which is what the driver produces by regenerating.
#
# The driver needs registering once per clone (git will not do it automatically):
#   git config merge.trellis-generated.name 'regenerate Trellis-generated files'
#   git config merge.trellis-generated.driver '.claude/scripts/merge-generated.sh %A %O %B %P'
#
# Trellis warns at session start if that has not been done.

docs/map/OVERVIEW.md merge=trellis-generated linguist-generated=true
docs/handoff/LATEST.md merge=trellis-generated linguist-generated=true
docs/runs/DIGEST.md merge=trellis-generated linguist-generated=true
