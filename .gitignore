# Runtime state, not source. The pattern rather than a list of names: this said
# `.claude/.verify-state.json` and nothing else, so when the gate lock arrived it was untracked —
# and delivery, which refuses to run on a dirty tree, refused whenever a gate run was in flight.
# Trellis ships nothing whose name starts with a dot directly inside .claude/, so the leading dot
# is the property that means "runtime".
.claude/.*

# OS
.DS_Store
Thumbs.db

# Credentials — never commit. Secret scanning should catch these too, but defence in depth.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore

# Dependencies and build output (whatever stack a project chooses)
node_modules/
dist/
build/
out/
.next/
target/
__pycache__/
*.py[cod]
.venv/
venv/

# Test and tool output
coverage/
test-results/
playwright-report/
.turbo/
.cache/

# Planning notes for building Trellis itself — not part of what Trellis is
PLAN.md
DECISIONS.md
