{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Bash(security:*)",
      "Bash(op:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh secret:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh workflow:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-production.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.py",
            "timeout": 960
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/write-handoff.py",
            "timeout": 60
          }
        ]
      }
    ]
  },

  "$notes": {
    "deny-vs-guard": "The deny list catches the obvious shapes cheaply and applies in every permission mode. The guard hook catches what a glob cannot -- environment-variable prefixes, pipes, encoded payloads, remote connection strings. Both exist because either alone is porous.",
    "ask-on-commit": "Commits and pushes prompt by default. Unattended runs override this with their own settings profile, which narrows rather than widens what is permitted.",
    "not-a-boundary": "None of this is a security boundary. It is a mistake-catcher. The real boundary is that production write credentials do not exist on this machine and the production role has no write grants."
  }
}
